# Bhakti Darshan Third-Party Service Configuration
# Configure real keys securely via the AI Studio Secrets panel (never commit real secrets).
# Note: Gemini AI features use Firebase AI Logic + App Check and require NO Gemini API key.

# Merchant UPI Donation Config (Leave UNCONFIGURED until real merchant UPI ID is ready)
UPI_MERCHANT_VPA=UNCONFIGURED
UPI_MERCHANT_NAME=Bhakti Darshan

# Panchang (Navamsha API)
NAVAMSHA_API_BASE_URL=UNCONFIGURED
NAVAMSHA_API_KEY=UNCONFIGURED

# Rashifal & Kundli (AstroLogics API)
ASTROLOGICS_API_BASE_URL=UNCONFIGURED
ASTROLOGICS_API_KEY=UNCONFIGURED

# Spiritual News (NewsAPI & MediaStack)
NEWS_API_KEY=UNCONFIGURED
MEDIASTACK_API_KEY=UNCONFIGURED

# Media & Voice Services (Cloudinary & Speechify)
CLOUDINARY_CLOUD_NAME=UNCONFIGURED
SPEECHIFY_API_KEY=UNCONFIGURED

# WhatsApp Business Cloud API & Contact
WHATSAPP_PHONE_NUMBER_ID=UNCONFIGURED
WHATSAPP_CONTACT_NUMBER=UNCONFIGURED
